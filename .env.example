# Jira Cloud credentials. Same three variables TimeSheetWizard uses, so an
# existing Netlify site's env vars can be copied across as-is.
#
# ATLASSIAN_DOMAIN — host only, no scheme and no trailing slash. It is the host
# in the URL you see when browsing Jira, e.g. "team-1234567890123.atlassian.net".
ATLASSIAN_DOMAIN=your-team.atlassian.net
ATLASSIAN_EMAIL=you@yourcompany.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_TOKEN=ATATT3xFfGF0...

# Jira project key holding the operational issues. Defaults to OPS.
OPS_PROJECT_KEY=OPS


# Optional. Enables the "What should I check?" analysis on a ticket, which asks
# Claude to read it alongside the most similar earlier tickets. Leave unset and
# the feature is hidden entirely — nothing calls out and nothing is billed.
# Needs `npm install @anthropic-ai/sdk` as well.
# ANTHROPIC_API_KEY=sk-ant-...
